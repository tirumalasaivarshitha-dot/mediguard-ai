# Server Configuration
PORT=5000
NODE_ENV=development

# Security & Authentication
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change_this_in_production_to_a_secure_random_key
JWT_EXPIRES_IN=24h

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ML Service Configuration
ML_SERVICE_URL=http://localhost:8000
# Required in production; keep unset for local development unless ML auth is enabled.
# ML_SERVICE_TOKEN=generate_a_long_random_value

# Dataset upload limit
DATASET_MAX_UPLOAD_MB=25
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
HISTORICAL_SAFETY_DATA_PATH=../storage/uploads/historical-safety
